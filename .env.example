# Copy to .env and fill in. NEVER commit .env.

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must exactly match an "Authorized redirect URI" on the OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Random secret used to sign the session cookie (generate your own!)
SESSION_SECRET=change-me-to-a-long-random-string

# Neon Postgres connection string. Use the POOLED url (host contains "-pooler").
# e.g. postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Fernet key for encrypting stored tokens. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=generate-a-fernet-key

# Comma-separated emails that get the agency-admin role (see ALL organizations).
# e.g. info@prompted-ai.nl,you@prompted-ai.nl
AGENCY_ADMIN_EMAILS=

# Optional: only needed for local testing over plain http
OAUTHLIB_INSECURE_TRANSPORT=1

# Wachtwoord van het demo-account (info@janssen.nl). Leeg laten = het demo-
# account krijgt bij elke start een willekeurig wachtwoord, zodat er geen
# bekende login openstaat. Vul dit alleen als je de demo-login wilt gebruiken.
DEMO_PASSWORD=

# Sessies: absolute levensduur van de cookie en de maximale stilte-periode
# voordat opnieuw inloggen nodig is (in seconden). Standaard 14 dagen / 12 uur.
SESSION_MAX_AGE=
SESSION_IDLE_MAX=

# Shopify-app (publieke installatieflow). Zonder deze drie doet de app alsof
# Shopify niet bestaat: een App URL-launch valt terug op de SPA en de bezoeker
# ziet een inlogscherm - de klassieke reden voor een afwijzing bij de review.
# Key en secret komen uit het Partner Dashboard -> je app -> Client credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Moet TEKEN VOOR TEKEN gelijk zijn aan een "Allowed redirection URL" van de app,
# bijv. https://dashboard.jouwdomein.nl/api/auth/shopify/callback
SHOPIFY_REDIRECT_URI=
# Alleen aanpassen als de app meer nodig heeft dan omzet- en productdata.
SHOPIFY_SCOPES=read_orders,read_products
# Shopify serveert een API-versie twaalf maanden. Hou dit gelijk aan de
# `api_version` in shopify.app.toml; een verlopen versie laat elke Admin-call
# falen (koppelen lukt dan wel, maar er komt geen data binnen).
SHOPIFY_API_VERSION=2026-07

# Optional: e-mail versturen voor uitnodigingen en wachtwoord-reset. Zonder deze
# variabelen wordt er niets gemaild en toont de admin-UI de link om zelf te
# delen. Werkt met elke SMTP-provider (SendGrid, Postmark, Mailgun, Gmail, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Publieke basis-URL voor de links in de e-mails (bijv. https://dashboard.jouwdomein.nl).
# Leeg = afgeleid uit het inkomende verzoek.
APP_BASE_URL=
